# ==========================================
# Phone AI Agent Configuration
# ==========================================

# Company Information
COMPANY_NAME="Acme Services"
COMPANY_PHONE="+1 (555) 123-4567"
BUSINESS_HOURS="Monday to Friday, 9:00 AM to 5:00 PM EST"
OFFICE_ADDRESS="123 Main Street, Suite 400, New York, NY"

# LiveKit Credentials (Sign up for free at https://cloud.livekit.io)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Speech-to-Text (Deepgram: https://deepgram.com)
DEEPGRAM_API_KEY="your-deepgram-api-key"

# LLM Provider Options: 'ollama' (Local AI), 'openai', or 'groq'
LLM_PROVIDER="openai"

# If using Local Ollama:
OLLAMA_BASE_URL="http://localhost:11434/v1" # or http://192.168.1.50:11434/v1 if running on LAN
OLLAMA_MODEL="llama3.1" # or qwen2.5, mistral, llama3.2
USE_OLLAMA_FOR_POST_CALL_SUMMARY=true # Uses Ollama for local private transcript analysis & summarization

# If using OpenAI / Groq:
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Text-to-Speech (Cartesia: https://cartesia.ai or ElevenLabs)
TTS_PROVIDER="cartesia" # Options: cartesia or elevenlabs
CARTESIA_API_KEY="your-cartesia-api-key"
CARTESIA_VOICE_ID="a0e99841-438c-4a64-b679-ae501e7d6091" # Friendly male or female voice ID

ELEVEN_API_KEY="your-elevenlabs-api-key"
ELEVEN_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # Rachel or preferred voice ID

# ==========================================
# Intake Alert & Notification Settings
# ==========================================

# Email Notification Settings (SMTP)
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST="smtp.gmail.com" # or smtp.mailgun.org, smtp-relay.sendgrid.net, etc.
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
NOTIFICATION_RECIPIENT_EMAIL="dispatch@example.com,manager@example.com"
NOTIFICATION_SENDER_EMAIL="ai-phone@example.com"

# SMS Notification Settings (Twilio)
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"
NOTIFICATION_RECIPIENT_PHONE="+15559876543"
